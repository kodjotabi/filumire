{
    "name":  "filumire-core",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "FILUMIRE EduTutor adaptive learning infrastructure for African children",
    "workspaces":  [
                       "apps/*",
                       "services/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "test":  "npm run test:adaptive \u0026\u0026 npm run test:progression \u0026\u0026 npm run test:security \u0026\u0026 npm run test:identity \u0026\u0026 npm run test:intervention \u0026\u0026 npm run test:language && npm run test:accounts && npm run test:ratelimit && npm run test:progress && npm run test:teacher-links && npm run test:learning-language && npm run test:integration-foundation && npm run test:revision && npm run test:security-offline",
                    "test:integration-foundation":  "node ./tests/integration-phase1-foundation.test.mjs && node ./tests/deploy-grade-lock-guard.test.mjs && npm run test:grade-lock",
                    "test:grade-lock":  "node ./scripts/run-offline-suites.mjs ./tests/grade-lock-schema-guard.test.ts ./tests/guardian-grade-lock.test.ts",
                    "test:security-offline": "node ./scripts/run-offline-suites.mjs",
                    "test:revision": "node ./scripts/run-offline-suites.mjs ./tests/spaced-revision.test.ts ./tests/time-aware-retention-v1.test.ts ./tests/time-aware-retention-engine-v1.test.ts",
                    "test:grade-navigation:browser":  "node ./scripts/grade-navigation-browser.mjs",
                    "migrations:verify":  "node ./scripts/migration-ledger.mjs verify",
                    "deploy:guard":  "node ./scripts/deploy-guard.mjs",
                    "test:adaptive":  "tsx --env-file=.env.local ./tests/adaptive-learning-loop.test.ts",
                    "test:progression":  "tsx --env-file=.env.local ./tests/competency-003-adaptive-loop.test.ts",
                    "test:security":  "tsx --env-file=.env.local ./tests/api-assessment-security.test.ts",
                    "test:identity":  "tsx --env-file=.env.local ./tests/api-identity-security.test.ts && node --import tsx ./tests/session-issue-rate-limit.test.ts && node --import tsx ./tests/teacher-learner-session-boundary.test.ts",
                    "test:intervention":  "tsx --env-file=.env.local ./tests/intervention-lifecycle.test.ts",
                    "test:language":  "tsx --env-file=.env.local ./tests/content-language-selection.test.ts",
                    "test:accounts":  "tsx --env-file=.env.local ./tests/account-registration-journey.test.ts",
                    "test:ratelimit":  "tsx --env-file=.env.local ./tests/auth-rate-limit.test.ts",
                    "test:progress":  "tsx --env-file=.env.local ./tests/learner-progress.test.ts",
                    "test:teacher-links":  "tsx --env-file=.env.local ./tests/teacher-linking.test.ts",
                    "test:learning-language":  "tsx --env-file=.env.local ./tests/learning-language.test.ts",
                    "test:section7":  "node scripts/test-section7.mjs",
                    "check:section7-readiness":  "node scripts/check-section7-readiness.mjs",
                    "build:learner":  "npm run build --workspace=@filumire/learner",
                    "validate:all":  "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-all.ps1"
                },
    "devDependencies":  {
                            "@types/pg":  "^8.23.1",
                            "drizzle-kit":  "^0.31.10",
                            "tsx":  "^4.23.12",
                            "typescript":  "^5.7.2"
                        },
    "dependencies":  {
                         "drizzle-orm":  "^0.45.2",
                         "jose":  "^6.2.10",
                         "pg":  "^8.23.0"
                     }
}

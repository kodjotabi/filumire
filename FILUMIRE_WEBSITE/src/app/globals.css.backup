    font-size: 10.5px !important;
    line-height: 1.2;
    text-align: right;
    white-space: nowrap;
  }
}

/* =========================================================
   ADAPTIVE DIFFERENCE - MOBILE STACK
   ========================================================= */

@media (max-width: 600px) {

  .adaptive-mobile-comparison {
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    overflow: visible !important;
  }

  .adaptive-mobile-header {
    display: none !important;
  }

  .adaptive-mobile-row {
    display: grid !important;
    grid-template-columns: 1fr !important;
    margin-bottom: 14px;
    overflow: hidden;
    border: 1px solid var(--ui-line) !important;
    border-radius: 14px;
    background: #ffffff;
    box-shadow: var(--shadow-sm);
  }

  .adaptive-mobile-row:last-child {
    margin-bottom: 0;
  }

  .adaptive-mobile-row > div {
    padding: 18px !important;
    font-size: 14.5px !important;
    line-height: 1.6;
  }

  .adaptive-mobile-row > div:first-child {
    border-bottom: 1px solid var(--ui-line);
  }

  .adaptive-mobile-row > div:first-child::before {
    content: "GENERIC LEARNING APPS";
    display: block;
    margin-bottom: 8px;
    color: var(--ui-ink-soft);
    font-size: 10px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
  }

  .adaptive-mobile-row > div:last-child {
    border-left: 0 !important;
    background: rgba(223, 245, 231, 0.34) !important;
  }

  .adaptive-mobile-row > div:last-child::before {
    content: "FILUMIRE";
    display: block;
    margin-bottom: 8px;
    color: var(--ui-brand);
    font-size: 10px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
  }
}

/* =========================================================
   MEET FILU - MOBILE REFINEMENT
   ========================================================= */

@media (max-width: 600px) {

  .filu-split-section {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .filu-card-frame {
    padding: 22px 18px;
    border-width: 1.5px;
    border-radius: 16px;
  }

  .filu-portrait-img {
    width: 100%;
    max-width: 185px;
    height: auto;
    margin: 0 auto 16px;
  }

  .filu-speech-bubble {
    padding: 14px 16px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.5;
  }

  .filu-points-list {
    gap: 16px;
    margin-top: 20px;
  }

  .filu-point-item {
    gap: 12px;
    align-items: flex-start;
  }

  .filu-point-bullet {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
  }
}

/* =========================================================
   5-STEP LEARNING SEQUENCE - MOBILE REFINEMENT
   ========================================================= */

@media (max-width: 600px) {

  .stepper-container {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .step-card {
    padding: 18px;
    min-height: 0;
    border-radius: 14px;
  }

  .step-card:hover {
    transform: none;
  }

  .step-title {
    font-size: 15px;
    line-height: 1.35;
    margin-bottom: 6px;
  }

  .step-desc {
    font-size: 13.5px;
    line-height: 1.55;
  }
}

/* =========================================================
   SUBJECTS & CURRICULUM - MOBILE REFINEMENT
   ========================================================= */

@media (max-width: 600px) {

  .subjects-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .subject-card {
    padding: 20px 18px;
    border-radius: 14px;
  }

  .subject-card:hover {
    transform: none;
  }

  .subject-header {
    gap: 12px;
  }

  .subject-icon-box {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border-radius: 10px;
  }

  .subject-icon-box img {
    width: 38px;
    height: 38px;
  }

  .subject-title {
    font-size: 18px;
    line-height: 1.25;
  }

  .subject-desc {
    font-size: 13.5px;
    line-height: 1.55;
    margin-bottom: 14px;
  }
}

/* =========================================================
   FILUMIRE HOMEPAGE - REMAINING MOBILE PASS
   ========================================================= */

@media (max-width: 600px) {

  /* ---------- Families / Schools ---------- */

  .audiences-grid {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
  }

  .audience-card {
    padding: 22px 18px !important;
    border-radius: 14px !important;
  }

  .audience-card:hover {
    transform: none !important;
  }

  /* ---------- Infrastructure / resilience ---------- */

  .resilience-grid,
  .infrastructure-grid {
    grid-template-columns: 1fr !important;
    gap: 14px !important;
  }

  .resilience-card,
  .infrastructure-card {
    padding: 20px 18px !important;
    border-radius: 14px !important;
  }

  /* ---------- Generic homepage two-column layouts ---------- */

  .two-column-grid,
  .split-grid,
  .feature-split {
    grid-template-columns: 1fr !important;
    gap: 24px !important;
  }

  /* ---------- Final CTA ---------- */

  .final-cta,
  .cta-section,
  .cta-card {
    text-align: center;
  }

  .final-cta .btn,
  .cta-section .btn,
  .cta-card .btn {
    width: 100%;
    min-height: 50px;
    justify-content: center;
  }

  /* ---------- Mobile images ---------- */

  .site-section img {
    max-width: 100%;
    height: auto;
  }

  /* ---------- Prevent horizontal escape ---------- */

  .site-section,
  .site-container {
    max-width: 100%;
    box-sizing: border-box;
  }

  .site-section {
    overflow-x: clip;
  }

  /* ---------- Touch behaviour ---------- */

  .subject-card:hover,
  .step-card:hover,
  .audience-card:hover {
    transform: none;
  }
}
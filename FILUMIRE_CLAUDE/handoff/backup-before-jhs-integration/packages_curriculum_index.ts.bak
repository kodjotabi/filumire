export interface CurriculumFramework {
  id: CurriculumFrameworkId;
  name: string;
  countryOrRegion: string;
  version: string;
}

export interface EducationSystem {
  id: EducationSystemId;
  curriculumFrameworkId: CurriculumFrameworkId;
  name: string;
  description?: string;
}

export interface LearningLevel {
  id: LearningLevelId;
  educationSystemId: EducationSystemId;
  name: string;
  order: number;
}

export interface Subject {
  id: SubjectId;
  learningLevelId: LearningLevelId;
  name: string;
  code: string;
}

export interface Strand {
  id: StrandId;
  subjectId: SubjectId;
  name: string;
  code: string;
  order: number;
}

export interface SubStrand {
  id: SubStrandId;
  strandId: StrandId;
  name: string;
  code: string;
  order: number;
}

export interface ContentStandard {
  id: ContentStandardId;
  subStrandId: SubStrandId;
  title: string;
  description: string;
}

export interface LearningIndicator {
  id: LearningIndicatorId;
  contentStandardId: ContentStandardId;
  statement: string;
  order: number;
}

export interface CompetencyDefinition {
  id: CompetencyId;

  curriculumFrameworkId: CurriculumFrameworkId;
  educationSystemId: EducationSystemId;
  learningLevelId: LearningLevelId;
  subjectId: SubjectId;
  strandId: StrandId;
  subStrandId: SubStrandId;
  contentStandardId: ContentStandardId;
  learningIndicatorId: LearningIndicatorId;

  title: string;
  description: string;

  prerequisiteCompetencyIds: CompetencyId[];
  successorCompetencyIds: CompetencyId[];
  relatedCompetencyIds: CompetencyId[];

  subskills: string[];
  misconceptions: string[];

  difficulty: number;

  masteryRequirements: {
    masteryThreshold: number;
    confidenceThreshold: number;
  };

  retentionRequirements: {
    required: boolean;
    confidenceThreshold: number;
  };

  transferRequirements: {
    required: boolean;
    confidenceThreshold: number;
  };
}


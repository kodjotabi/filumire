const LESSONS: Lesson[] = [
  {
    key: "lesson",
    type: "lesson",
    strategy: "direct_explanation",
    title: { en: "Proper and Common Nouns", fr: "Noms propres et noms communs" },
    body: {
      en: "A common noun names any person, animal, place or thing of a kind, such as girl, river or city. A proper noun names one particular person, place or thing, such as Ama, Volta or Accra, and it always begins with a capital letter. To tell them apart, ask: is this a general kind or one special name? A word at the start of a sentence has a capital letter too, but that does not make it a proper noun. Always write the capital letter for proper nouns.",
      fr: "Un nom commun désigne n'importe quelle personne, n'importe quel animal, lieu ou chose d'une sorte, comme girl, river ou city. Un nom propre désigne une personne, un lieu ou une chose particulière, comme Ama, Volta ou Accra, et il commence toujours par une majuscule. Pour les distinguer, demande-toi : est-ce une sorte générale ou un nom spécial ? Un mot au début d'une phrase a aussi une majuscule, mais cela n'en fait pas un nom propre. Écris toujours la majuscule pour les noms propres.",
    },
  },
  {
    key: "example",
    type: "example",
    strategy: "worked_example",
    title: { en: "Worked Example", fr: "Exemple résolu" },
    body: {
      en: "Sentence: The boy visited Kumasi. Step 1: boy is a kind of person, so it is a common noun. Step 2: Kumasi is the name of one city, so it is a proper noun. Step 3: so Kumasi needs a capital letter. Step 4: he checks The, which has a capital only because it starts the sentence. It is not a noun at all.",
      fr: "Phrase : The boy visited Kumasi. Étape 1 : boy est une sorte de personne, donc c'est un nom commun. Étape 2 : Kumasi est le nom d'une seule ville, donc c'est un nom propre. Étape 3 : donc Kumasi a besoin d'une majuscule. Étape 4 : il vérifie The, qui a une majuscule seulement parce qu'il commence la phrase. Ce n'est pas un nom du tout.",
    },
  },
  {
    key: "scaffold",
    type: "scaffold",
    strategy: "step_by_step_scaffold",
    title: { en: "Step by Step", fr: "Pas à pas" },
    body: {
      en: "To use proper and common nouns, use these steps. Step 1: find the noun. Step 2: ask if it is a general kind or one special name. Step 3: write a capital letter for a proper noun. Step 4: keep common nouns in small letters unless they start a sentence.",
      fr: "Pour utiliser les noms propres et communs, utilise ces étapes. Étape 1 : trouve le nom. Étape 2 : demande si c'est une sorte générale ou un nom spécial. Étape 3 : écris une majuscule pour un nom propre. Étape 4 : garde les noms communs en minuscules sauf au début d'une phrase.",
    },
  },
  {
    key: "remediation",
    type: "remediation",
    strategy: "error_analysis",
    title: { en: "Check Your Thinking", fr: "Vérifie ta réflexion" },
    body: {
      en: "Three slips are common. Some pupils think every capitalised word is a proper noun. Some mix a category name with a specific name. Some forget the capital letter on a proper noun. Ask: one special name or a kind?",
      fr: "Trois erreurs sont fréquentes. Certains élèves pensent que tout mot à majuscule est un nom propre. Certains mélangent un nom de catégorie avec un nom précis. Certains oublient la majuscule d'un nom propre. Demande : un nom spécial ou une sorte ?",
    },
  },
];


import { buildTopic } from "./authored-builder";
import type { Lesson, Question } from "./authored-builder";

export const GHANA_B4_COMP_DATA_COLLECTION_TOOLS_AUTHORED_COMPETENCY_ID =
  "competency-gh-computing-b4-data-collection-tools-001";

const LESSONS: Lesson[] = [
  {
    key: "lesson",
    type: "lesson",
    strategy: "direct_explanation",
    title: { en: "Data Collection Tools", fr: "Les outils de collecte de données" },
    body: {
      en: "There are different ways to collect data. In an interview we ask people questions and record their answers, which is good for opinions and experiences. In observation we watch what happens and record it, such as counting cars at a junction. A checklist is a list of items we tick or mark as we collect, such as which pupils are present. A checklist is only a tool for recording. It becomes data once it has been filled in. No single method suits every task, so we choose the method that fits what we want to find out.",
      fr: "Il y a différentes façons de collecter des données. Dans une entrevue, nous posons des questions aux gens et enregistrons leurs réponses, ce qui convient pour les opinions et les expériences. Dans l'observation, nous regardons ce qui se passe et nous l'enregistrons, comme compter les voitures à un carrefour. Une liste de contrôle est une liste d'éléments que nous cochons ou marquons pendant la collecte, comme quels élèves sont présents. Une liste de contrôle n'est qu'un outil pour enregistrer. Elle devient des données une fois remplie. Aucune méthode seule ne convient à toutes les tâches, donc nous choisissons la méthode qui convient à ce que nous voulons découvrir.",
    },
  },
  {
    key: "example",
    type: "example",
    strategy: "worked_example",
    title: { en: "Worked Example", fr: "Exemple résolu" },
    body: {
      en: "A class wants to know how many pupils arrive late and why. Step 1: to count late pupils at the gate, they use observation with a checklist of names. Step 2: to find out why, they interview the late pupils. Step 3: the blank checklist is only a tool, and the ticks they add make it data.",
      fr: "Une classe veut savoir combien d'élèves arrivent en retard et pourquoi. Étape 1 : pour compter les élèves en retard à la porte, ils utilisent l'observation avec une liste de contrôle de noms. Étape 2 : pour savoir pourquoi, ils interrogent les élèves en retard. Étape 3 : la liste vide n'est qu'un outil, et les coches qu'ils ajoutent en font des données.",
    },
  },
  {
    key: "scaffold",
    type: "scaffold",
    strategy: "step_by_step_scaffold",
    title: { en: "Step by Step", fr: "Pas à pas" },
    body: {
      en: "To choose a method, use these steps. Step 1: decide what you want to find out. Step 2: if you need opinions or reasons, use an interview. Step 3: if you need to count or watch events, use observation. Step 4: use a checklist to record items as you go.",
      fr: "Pour choisir une méthode, utilise ces étapes. Étape 1 : décide ce que tu veux découvrir. Étape 2 : si tu as besoin d'opinions ou de raisons, utilise une entrevue. Étape 3 : si tu as besoin de compter ou de regarder des événements, utilise l'observation. Étape 4 : utilise une liste de contrôle pour enregistrer les éléments au fur et à mesure.",
    },
  },
  {
    key: "remediation",
    type: "remediation",
    strategy: "error_analysis",
    title: { en: "Check Your Thinking", fr: "Vérifie ta réflexion" },
    body: {
      en: "Three slips are common. Some pupils think one method suits every task, but opinions need interviews and counting needs observation. Some think observation is guessing, but it means carefully watching and recording. Some treat a blank checklist as finished data. It only becomes data when it is filled in. Match the tool to the question.",
      fr: "Trois erreurs sont fréquentes. Certains élèves pensent qu'une seule méthode convient à toutes les tâches, mais les opinions demandent des entrevues et le comptage demande de l'observation. Certains pensent que l'observation est une supposition, mais cela veut dire regarder avec soin et enregistrer. Certains traitent une liste de contrôle vide comme des données terminées. Elle ne devient des données qu'une fois remplie. Associe l'outil à la question.",
    },
  },
];


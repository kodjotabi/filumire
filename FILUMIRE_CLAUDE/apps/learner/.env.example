# Learner app settings. Copy to .env.local (git-ignored) and fill in.

# "memory" (default; data lost on restart) or "postgres".
FILUMIRE_PERSISTENCE=postgres

# Postgres connection. Locally this is the filumire_test database.
# Apply FILUMIRE_CLAUDE/drizzle/0019_learner_accounts.sql before using
# built-in accounts with Postgres.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/filumire_test

# Signs session cookies. Required for any sign-in; 32+ random characters,
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FILUMIRE_AUTH_JWT_SECRET=

# Production builds refuse new registrations unless this is "open".
# Leave unset until the privacy and consent review is complete.
# FILUMIRE_ACCOUNT_REGISTRATION=open

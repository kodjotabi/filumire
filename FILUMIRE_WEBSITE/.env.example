# Set only owner-approved public URLs. A protected learner Preview is not a public service.
NEXT_PUBLIC_FILUMIRE_LEARNER_APP_URL=
NEXT_PUBLIC_FILUMIRE_LEARNER_PUBLIC_APPROVED=false
NEXT_PUBLIC_FILUMIRE_PARENT_PORTAL_URL=
NEXT_PUBLIC_FILUMIRE_PARENT_PUBLIC_APPROVED=false
NEXT_PUBLIC_FILUMIRE_TEACHER_PORTAL_URL=
NEXT_PUBLIC_FILUMIRE_TEACHER_PUBLIC_APPROVED=false
# Confirmed defaults: info@filumire.com (families/general), schools@filumire.com
# (teachers/pilots), hello@filumire.com (curriculum/partnerships).
# Optional overrides require verification; blank/false keeps the confirmed default.
NEXT_PUBLIC_FILUMIRE_CONTACT_EMAIL=
NEXT_PUBLIC_FILUMIRE_CONTACT_EMAIL_VERIFIED=false
NEXT_PUBLIC_FILUMIRE_SCHOOLS_EMAIL=
NEXT_PUBLIC_FILUMIRE_SCHOOLS_EMAIL_VERIFIED=false
NEXT_PUBLIC_FILUMIRE_PARTNERS_EMAIL=
NEXT_PUBLIC_FILUMIRE_PARTNERS_EMAIL_VERIFIED=false
# Set the approved website origin before a future Preview build, for canonical/hreflang.
NEXT_PUBLIC_FILUMIRE_SITE_URL=http://127.0.0.1:3147

# Native contact: all enquiries route server-side to info@filumire.com.
# Enable only after supplying the real Zoho SMTP configuration.
# Server-only credentials: never prefix these keys with NEXT_PUBLIC_.
FILUMIRE_CONTACT_ENABLED=false
FILUMIRE_SMTP_HOST=
FILUMIRE_SMTP_PORT=465
FILUMIRE_SMTP_USER=
FILUMIRE_SMTP_PASSWORD=
# This sender must be authorised for the configured SMTP account.
FILUMIRE_CONTACT_FROM=info@filumire.com
# Legacy contact sender and separate authentication email sender:
FILUMIRE_SMTP_FROM=

# Subscriptions: LOCAL development only. Never configure these in Production.
FILUMIRE_SUBSCRIPTIONS_ENABLED=false
FILUMIRE_BILLING_STORAGE=sqlite-local
FILUMIRE_BILLING_ORIGIN=http://127.0.0.1:3147
# Generate at least 32 random characters; server-only, not a payment credential.
FILUMIRE_AUTH_SECRET=
# Separately approved authentication email sending, using existing Zoho SMTP fields.
FILUMIRE_AUTH_EMAIL_ENABLED=false
# Keep false until the full learning platform is actually connected and verified.
FILUMIRE_WEBSITE_LEARNING_READY=false
PAYSTACK_MODE=test
# Accepts sk_test_ only. Leave empty until the owner supplies a test key securely.
PAYSTACK_SECRET_KEY=
